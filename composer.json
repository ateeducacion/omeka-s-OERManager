{
    "name": "ate/oer-manager",
    "description": "Omeka S module to manage a catalog of Open Educational Resources (items of class lrmi:LearningResource): curation, curricular alignment, integrity checks and statistics.",
    "license": "GPL-3.0-or-later",
    "type": "library",
    "require": {
        "php": ">=8.4",
        "smalot/pdfparser": "^2.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^3.13",
        "zerocrates/extract-tagged-strings": "dev-master"
    },
    "autoload": {
        "psr-4": {
            "OERManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OERManager\\Test\\": "test/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/zerocrates/extract-tagged-strings.git"
        }
    ],
    "archive": {
        "exclude": [
            "/vendor",
            "/test",
            "/docs",
            "/.claude",
            "/.github",
            "/.gitignore",
            "/blueprint.json",
            "/Makefile",
            "/composer.lock",
            "/package.json",
            "/prompt_fase0.md",
            "/prompt_fase1.md",
            "/CLAUDE.md"
        ]
    }
}
