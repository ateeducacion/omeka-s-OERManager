{
  "$schema": "https://omeka-s-contrib.github.io/omeka-s-blueprints/schema/v0/blueprint-schema.json",
  "install": {
    "title": "OER Manager Playground",
    "locale": "es",
    "timezone": "Atlantic/Canary"
  },
  "users": [
    {
      "username": "admin",
      "email": "admin@example.com",
      "password": "password",
      "role": "global_admin"
    },
    {
      "username": "editor",
      "email": "editor@example.com",
      "password": "password",
      "role": "editor",
      "settings": {
        "limit_to_granted_sites": false,
        "limit_to_own_assets": false
      }
    }
  ],
  "modules": [
    {
      "name": "OERManager",
      "state": "activate",
      "source": "https://github.com/ateeducacion/omeka-s-OERManager/archive/refs/heads/main.zip"
    }
  ],
  "vocabularies": [
    {
      "prefix": "lrmi",
      "namespaceUri": "http://purl.org/dcx/lrmi-terms/",
      "label": "LRMI",
      "comment": "Learning Resource Metadata Initiative (DCMI).",
      "format": "turtle",
      "source": "https://www.dublincore.org/specifications/lrmi/lrmi_terms/2022-06-14/lrmi-terms.ttl"
    },
    {
      "prefix": "schema",
      "namespaceUri": "https://schema.org/",
      "label": "schema.org",
      "format": "rdfxml",
      "source": "https://schema.org/version/latest/schemaorg-current-https.rdf"
    }
  ],
  "sites": [
    {
      "title": "OER Manager Playground",
      "slug": "oer-manager",
      "theme": "default",
      "summary": "Instalacion para probar el modulo OERManager en Omeka-S Playground, con los vocabularios LRMI y schema.org que usa. El grafo curricular (DefinedTermSets, ADR-0006) no se incluye: este preview demuestra la instalacion/activacion del modulo, no la catalogacion curricular completa.",
      "isPublic": true,
      "setAsDefault": true
    }
  ],
  "x-playground": {
    "debug": {
      "enabled": true
    },
    "landingPage": "/admin"
  }
}
