<?php
/**
 * Botones del flujo de curación en la página nativa del item (TASK-067).
 *
 * Se inyecta en `#page-actions`, la barra fija de 48px del core, detrás de la
 * insignia de estado (workflow-badge.phtml). Rediseño de 2026-11-18 sobre la
 * revisión del propietario, con el lenguaje visual de ADR-0014 (estilos de
 * botón del admin: `.button`, `.red.button`, `.green.button`):
 *
 * - una sola acción principal por estado, a la derecha y en verde
 *   (proponer, confirmar y publicar) o neutra (reabrir);
 * - las acciones que piden motivo (rechazar, despublicar, descartar) no
 *   ocupan la barra con su campo: «Acción…» abre bajo la barra un panel con
 *   la etiqueta, el campo y la confirmación con el mismo verbo. Es un
 *   `<details>`, así que funciona sin JavaScript; `workflow-actions.js` solo
 *   cierra los demás, enfoca el campo y cierra con Esc o «Cancelar»;
 * - solo «Descartar» va en rojo: es la única salida terminal.
 *
 * `required` + comprobación de servidor: ninguna transición con motivo se
 * acepta sin él (revisión final de RF-016, hallazgo 3).
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var int $itemId
 * @var string $csrf
 * @var bool $canPropose
 * @var bool $canReject
 * @var bool $canPublish
 * @var bool $canDiscard
 * @var bool $canUnpublish
 * @var bool $canReopen
 * @var string $proposeUrl
 * @var string $rejectUrl
 * @var string $publishUrl
 * @var string $discardUrl
 * @var string $unpublishUrl
 * @var string $reopenUrl
 * @var list<string>|null $rejectReasons TASK-039; null = free text
 * @var list<string>|null $discardReasons TASK-039; null = free text
 */
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');

$reasonActions = [
    [
        'show' => $canReject, 'url' => $rejectUrl, 'key' => 'reject', 'tone' => '',
        'open' => $translate('Rechazar…'), 'label' => $translate('Motivo del rechazo'),
        'confirm' => $translate('Rechazar'),
        'help' => $translate('El REA vuelve a quien lo propuso, que verá este motivo.'),
        'terms' => $rejectReasons ?? null, 'controlled' => true,
    ],
    [
        'show' => $canUnpublish, 'url' => $unpublishUrl, 'key' => 'unpublish', 'tone' => '',
        'open' => $translate('Despublicar…'), 'label' => $translate('Motivo para despublicar'),
        'confirm' => $translate('Despublicar'),
        'help' => $translate('El REA deja de ser público y vuelve a la cola de curación.'),
        'terms' => null, 'controlled' => false,
    ],
    [
        'show' => $canDiscard, 'url' => $discardUrl, 'key' => 'discard', 'tone' => ' red',
        'open' => $translate('Descartar…'), 'label' => $translate('Motivo del descarte'),
        'confirm' => $translate('Descartar'),
        'help' => $translate('El REA no se publicará. Un curador puede reabrirlo.'),
        'terms' => $discardReasons ?? null, 'controlled' => true,
    ],
];

$hidden = static function () use ($escape, $csrf, $itemId): string {
    return '<input type="hidden" name="csrf" value="' . $escape($csrf) . '">'
        . '<input type="hidden" name="id" value="' . (int) $itemId . '">';
};
?>
<div class="oer-workflow-actions">
<?php foreach ($reasonActions as $action): ?>
<?php if ($action['show']): ?>
<?php $fieldId = 'oer-workflow-' . $action['key'] . '-' . (int) $itemId; ?>
    <details class="oer-workflow-reason">
        <summary class="button<?php echo $action['tone']; ?>"><?php echo $escape($action['open']); ?></summary>
        <form method="post" action="<?php echo $escape($action['url']); ?>"
            class="oer-workflow-form oer-workflow-reason-panel oer-workflow-<?php echo $escape($action['key']); ?>">
            <?php echo $hidden(); ?>
            <?php echo $this->partial('oer-manager/common/workflow-reason-field', [
                'fieldId' => $fieldId,
                'label' => $action['label'],
                'terms' => $action['terms'],
                'controlled' => $action['controlled'],
                'describedBy' => $fieldId . '-help',
            ]); ?>
            <p class="oer-workflow-reason-help" id="<?php echo $escape($fieldId); ?>-help">
                <?php echo $escape($action['help']); ?>
            </p>
            <div class="oer-workflow-reason-buttons">
                <button type="submit" class="button<?php echo $action['tone']; ?>"><?php echo $escape($action['confirm']); ?></button>
                <button type="button" class="button" data-oer-workflow-cancel><?php echo $translate('Cancelar'); ?></button>
            </div>
        </form>
    </details>
<?php endif; ?>
<?php endforeach; ?>
<?php if ($canReopen): ?>
    <form method="post" action="<?php echo $escape($reopenUrl); ?>" class="oer-workflow-form">
        <?php echo $hidden(); ?>
        <button type="submit" class="button"><?php echo $translate('Reabrir'); ?></button>
    </form>
<?php endif; ?>
<?php if ($canPropose): ?>
    <form method="post" action="<?php echo $escape($proposeUrl); ?>" class="oer-workflow-form">
        <?php echo $hidden(); ?>
        <button type="submit" class="button green"><?php echo $translate('Proponer para revisión'); ?></button>
    </form>
<?php endif; ?>
<?php if ($canPublish): ?>
    <form method="post" action="<?php echo $escape($publishUrl); ?>" class="oer-workflow-form">
        <?php echo $hidden(); ?>
        <button type="submit" class="button green"><?php echo $translate('Confirmar y publicar'); ?></button>
    </form>
<?php endif; ?>
</div>
