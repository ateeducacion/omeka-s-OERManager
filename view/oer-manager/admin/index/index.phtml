<?php
/**
 * Vista maestra del catálogo REA (TASK-003, ADR-0005; columnas por el mecanismo
 * nativo bajo la clave `oer_items` desde TASK-028). Página server-rendered: la
 * parte asíncrona (drawer, visibilidad, re-catalogador y propose IA) son módulos
 * ES con una única entrada, asset/js/main.js.
 *
 * @var \Omeka\Api\Representation\ItemRepresentation[] $items
 * @var array $query
 * @var array $resourceTypeValues términos del CustomVocab, o [] si degrada (D1)
 */
$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
/** @var bool $isTruncated */
/** @var string $csrfToken */

$this->headLink()->appendStylesheet($this->assetUrl('css/oer-master-view.css', 'OERManager'));
// TASK-028: única entrada, módulos ES (asset/js/main.js).
$this->headScript()->appendFile($this->assetUrl('js/main.js', 'OERManager'), 'module');
?>
<?php echo $this->pageTitle($translate('OER Manager')); ?>

<div class="oer-toolbar">
<form id="oer-master-view-filters" method="get">
    <div class="oer-filter-row">
        <label class="oer-visually-hidden" for="oer-filter-title"><?php echo $translate('Título'); ?></label>
        <input type="text" id="oer-filter-title" name="title" value="<?php echo $escape($query['title'] ?? ''); ?>" placeholder="<?php echo $escape($translate('Buscar por título')); /* @translate */ ?>">
        <label class="oer-visually-hidden" for="oer-filter-visibility"><?php echo $translate('Visibilidad'); ?></label>
        <select id="oer-filter-visibility" name="visibility">
            <option value=""><?php echo $translate('Visibilidad (todas)'); ?></option>
            <option value="public" <?php echo ($query['visibility'] ?? '') === 'public' ? 'selected' : ''; ?>><?php echo $translate('Público'); ?></option>
            <option value="private" <?php echo ($query['visibility'] ?? '') === 'private' ? 'selected' : ''; ?>><?php echo $translate('Privado'); ?></option>
        </select>
        <label class="oer-visually-hidden" for="oer-filter-alignment"><?php echo $translate('Anclaje'); ?></label>
        <select id="oer-filter-alignment" name="alignment">
            <option value=""><?php echo $translate('Anclaje: todos'); ?></option>
            <option value="complete" <?php echo ($query['alignment'] ?? '') === 'complete' ? 'selected' : ''; ?>><?php echo $translate('Completo'); ?></option>
            <option value="partial" <?php echo ($query['alignment'] ?? '') === 'partial' ? 'selected' : ''; ?>><?php echo $translate('Parcial'); ?></option>
            <option value="none" <?php echo ($query['alignment'] ?? '') === 'none' ? 'selected' : ''; ?>><?php echo $translate('Sin alinear'); ?></option>
        </select>
        <label class="oer-visually-hidden" for="oer-filter-integrity"><?php echo $translate('Integridad'); ?></label>
        <select id="oer-filter-integrity" name="integrity">
            <option value=""><?php echo $translate('Integridad: todas'); ?></option>
            <option value="ok" <?php echo 'ok' === ($query['integrity'] ?? '') ? 'selected' : ''; ?>>
                <?php echo $translate('Ficha completa'); ?>
            </option>
            <option value="warning" <?php echo 'warning' === ($query['integrity'] ?? '') ? 'selected' : ''; ?>>
                <?php echo $translate('Con incidencias'); ?>
            </option>
        </select>
        <button type="submit" class="button oer-button-primary"><?php echo $translate('Filtrar'); ?></button>
        <?php echo $this->hyperlink(
            $translate('Búsqueda avanzada'),
            $this->url('admin/oer-manager', ['action' => 'search'], ['query' => $query]),
            ['class' => 'advanced-search']
        ); ?>
    </div>
    <?php
    // Los filtros avanzados viajan ocultos: sin esto, filtrar por título desde la
    // barra rápida borraría en silencio lo que el curador acotó en la otra
    // pantalla. Se quitan desde su chip.
    foreach (['stage', 'subject', 'project', 'axis', 'resource_type', 'licence'] as $advanced):
        if ('' === (string) ($query[$advanced] ?? '')) {
            continue;
        }
        ?>
    <input type="hidden" name="<?php echo $escape($advanced); ?>" value="<?php echo $escape($query[$advanced]); ?>">
    <?php endforeach; ?>
    <?php
    // `missing` es un array (missing[]=licence&missing[]=title, ...): no cabe en
    // el bucle plano de arriba, necesita su propio bucle anidado con name="missing[]"
    // por cada clave marcada. Sin esto, los cuatro filtros «sin X» de gobernanza se
    // borraban en silencio al filtrar desde la barra rápida, igual que el resto de
    // filtros avanzados de arriba.
    foreach ((array) ($query['missing'] ?? []) as $missingValue):
        ?>
    <input type="hidden" name="missing[]" value="<?php echo $escape((string) $missingValue); ?>">
    <?php endforeach; ?>
</form>
<?php echo $this->searchFilters('oer-manager/common/search-filters'); ?>
</div>

