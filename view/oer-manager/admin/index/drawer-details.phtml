<?php
/**
 * Panel de detalle del REA, servido al sidebar nativo del admin (TASK-034,
 * ADR-0017 §1). Antes lo pintaba entero `asset/js/ui/drawerDetails.js` desde
 * JSON; el sidebar del core hace `$.get` + `.html()`, así que el markup vive
 * aquí. De paso su copy entra por primera vez en `make generate-pot`, que solo
 * escanea `*.php` y `*.phtml` (NFR-005).
 *
 * Deja dos huecos que rellena el cliente y que NO pueden servirse desde aquí:
 * `.oer-anchor-slot`, donde se monta el re-catalogador —necesita el `itemJson`
 * de una llamada aparte—, y el cuerpo del historial, que es perezoso.
 *
 * Task 11 adds a third: `.oer-governance-form`, which `asset/js/ui/governance.js`
 * fills in place of the read rows when `canEdit` is true. Unlike the anchor
 * slot, this one carries its own data — `data-governance` on the section —
 * because `governance.js` only ever receives a DOM root from `drawerDetails.js`
 * (its exported `init(root)` is its whole public surface), never the
 * page-level `config` object `main.js` builds for the other UI modules. So
 * everything the form needs (current values, vocab options, notices, the
 * default rights holder, and the per-load CSRF hash) travels as JSON in that
 * one attribute, server-rendered here and read once when «Editar» is clicked.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var array|null $panel
 * @var array|null $integrity
 * @var array|null $governance `GovernanceService::read()` plus `canEdit` and `csrf` (Task 9)
 * @var array $areas
 * @var string $rail
 * @var string|null $workflowStatus estado de curación (RF-016), null=Borrador
 * @var bool $canReject
 * @var bool $canPublish
 * @var string $workflowCsrf
 * @var string $rejectUrl
 * @var string $publishUrl
 * @var string $governanceApplyUrl POST target for the edit form (Task 11)
 */

use OERManager\Service\Governance\GovernanceFields;
use OERManager\Service\Governance\IntegrityPolicy;
use OERManager\Service\Governance\LicenceStatus;
use OERManager\Service\Governance\ValueText;
use OERManager\Service\PanelAreas;

$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');

/** Área por id, para no depender del orden al pintar. */
$area = function (string $id) use ($areas): array {
    foreach ($areas as $one) {
        if ($id === $one['id']) {
            return $one;
        }
    }
    return ['id' => $id, 'state' => PanelAreas::STATE_UNKNOWN];
};

$termLabels = [
    'dcterms:description' => $translate('Descripción'),
    'lrmi:educationalLevel' => $translate('Etapa'),
    'schema:about' => $translate('Materia'),
    'lrmi:assesses' => $translate('Criterios de evaluación'),
    'lrmi:teaches' => $translate('Saberes básicos'),
    'dcterms:relation' => $translate('Eje temático'),
    'schema:isPartOf' => $translate('Proyecto'),
    'lrmi:learningResourceType' => $translate('Tipo de recurso'),
    IntegrityPolicy::LICENSE_TERM => $translate('Licencia'),
    GovernanceFields::CREATOR => $translate('Autoría'), // @translate
    GovernanceFields::PUBLISHER => $translate('Editor'), // @translate
    GovernanceFields::RIGHTS_HOLDER => $translate('Titular de derechos'), // @translate
    GovernanceFields::SOURCE => $translate('Fuente'), // @translate
];

// Missing text PER FIELD (the ADR-0014 rule this branch already follows,
// extended to governance in Task 9): with 19/19 catalogue items lacking
// authorship, a glyph on every field would mark the whole block and stop
// signalling the exception — same criterion `ColumnType\GovernanceValue`
// already applies in the table. Each of the five has its own text so the
// absence says WHAT is missing.
$governanceMissingText = [
    GovernanceFields::LICENCE => 'Sin licencia', // @translate
    GovernanceFields::CREATOR => 'Sin autoría', // @translate
    GovernanceFields::PUBLISHER => 'Sin editor', // @translate
    GovernanceFields::RIGHTS_HOLDER => 'Sin titular de derechos', // @translate
    GovernanceFields::SOURCE => 'Sin fuente', // @translate
];

/** Displayable text for a list of governance values (uri or literal), comma-joined. */
$governanceFieldText = static function (array $entries): string {
    $texts = [];
    foreach ($entries as $entry) {
        $text = isset($entry['uri'])
            ? ValueText::of($entry['label'] ?? null, $entry['uri'])
            : (string) ($entry['value'] ?? '');
        if ('' !== $text) {
            $texts[] = $text;
        }
    }
    return implode(', ', $texts);
};

// El código de razón de `CurricularGrouping::build` cubre DOS casos: un valor
// cuyo curso no está declarado, y uno cuyo curso sí lo está pero al que ninguna
// materia sostiene. Los textos se redactan para ser ciertos en ambos.
$orphanReasons = [
    'course-without-subject' => $translate('ninguna materia lo sostiene'),
    'course-not-declared' => $translate('sin un curso que lo agrupe en este REA'),
];

$severityLabels = [
    'error' => $translate('Errores'),
    'warning' => $translate('Avisos'),
];

// `jsTranslate` no hacía plurales y aquí tampoco los hace `translate`: la
// elección se resuelve en el sitio y cada forma viaja al catálogo por su cuenta.
$severityCounts = [
    'error' => [$translate('error'), $translate('errores')],
    'warning' => [$translate('aviso'), $translate('avisos')],
];

$issueGroups = [];
if (null !== $integrity) {
    foreach ($integrity['issues'] ?? [] as $issue) {
        $issueGroups[$issue['severity'] ?? 'warning'][] = $issue;
    }
    // Errores antes que avisos; una severidad desconocida no se descarta, va al
    // final: mejor enseñar algo sin ordenar que esconder una incidencia real.
    uksort($issueGroups, function ($a, $b) {
        $order = ['error' => 0, 'warning' => 1];
        return ($order[$a] ?? 9) <=> ($order[$b] ?? 9);
    });
}
$checked = null !== $integrity && !empty($integrity['status']);
?>
<div class="oer-detail-panel" data-integrity="<?php echo $escape($rail); ?>">
<?php if (null === $panel): ?>
    <p class="oer-drawer-empty"><?php echo $escape($translate(PanelAreas::PANEL_ERROR_TEXT)); ?></p>
    <div class="oer-anchor-slot"></div>
    <div class="oer-anchor-bar"></div>
<?php else: ?>
    <?php $identity = $panel['identity']; ?>
    <?php
    // El título va SOLO y primero, como `<h3>` directo del sidebar: el admin le
    // da a `.sidebar h3` una banda de cabecera propia (un `::after` gris a
    // sangre), que es como se presenta cualquier panel lateral de Omeka.
    // Aprovecharla es heredar el chrome (ADR-0014 §1); meterlo en una fila flex
    // con la miniatura hacía que esa banda cayera torcida. El core ya le
    // reserva el hueco del aspa con su `padding-right`.
    ?>
    <h3 class="oer-panel-title">
        <?php echo $escape('' === $identity['title'] ? $translate('(sin título)') : $identity['title']); ?>
    </h3>
    <div class="oer-panel-header">
        <?php // Un REA sin miniatura es un dato, no un fallo de carga: hueco, no icono roto. ?>
        <span class="oer-panel-thumb<?php echo $identity['thumbnail'] ? '' : ' oer-panel-thumb-none'; ?>">
            <?php if ($identity['thumbnail']): ?>
            <img src="<?php echo $escape($identity['thumbnail']); ?>" alt="">
            <?php endif; ?>
        </span>
        <div class="oer-panel-meta">
            <span class="oer-panel-visibility">
                <?php echo $escape($identity['isPublic'] ? $translate('Público') : $translate('Privado')); ?>
            </span>
            <?php
            // Veredicto: solo cuando NO hay banda. Dos estados con glifo propio
            // además de color (ADR-0014 §3), porque «no se pudo comprobar» y «se
            // comprobó y está limpio» no pueden acabar pintando lo mismo.
            ?>
            <?php if (!$issueGroups): ?>
            <span class="oer-panel-verdict oer-panel-verdict-<?php echo $checked ? 'ok' : 'unknown'; ?>">
                <?php echo $escape($checked
                    ? $translate('Sin incidencias')
                    : $translate('Integridad no verificada')); ?>
            </span>
            <?php endif; ?>
            <?php if ($identity['editUrl']): ?>
            <a class="oer-drawer-edit-link" href="<?php echo $escape($identity['editUrl']); ?>">
                <?php echo $escape($translate('Abrir en el editor de Omeka')); ?>
            </a>
            <?php endif; ?>
        </div>
    </div>

    <?php
    // Rechazar/publicar desde el drawer (extensión RF-016 post-PR#38): mismo
    // criterio de visibilidad que la página nativa del item
    // (`workflow-actions.phtml`/`addWorkflowActions()`), pero aquí el
    // formulario lo intercepta `workflowDrawer.js` y lo envía por AJAX —el
    // drawer entero es 100% AJAX (ADR-0017 §1), a diferencia de la página
    // nativa— para no perder el filtro activo del curador al ir y volver.
    ?>
    <?php if ($canReject || $canPublish): ?>
    <section class="oer-panel-workflow" data-status="<?php echo $escape((string) $workflowStatus); ?>">
        <p class="oer-workflow-status">
            <?php echo $escape(sprintf($translate('Estado del flujo: %s'), $workflowStatus)); ?>
        </p>
        <?php if ($canReject): ?>
        <form
            method="post"
            action="<?php echo $escape($rejectUrl); ?>"
            class="oer-workflow-form oer-drawer-workflow-form"
        >
            <input type="hidden" name="csrf" value="<?php echo $escape($workflowCsrf); ?>">
            <input type="hidden" name="id" value="<?php echo (int) $identity['id']; ?>">
            <input
                type="text"
                name="reason"
                required
                maxlength="200"
                placeholder="<?php echo $escape($translate('Motivo del rechazo')); ?>"
                aria-label="<?php echo $escape($translate('Motivo del rechazo')); ?>"
            >
            <button type="submit" class="button"><?php echo $translate('Rechazar propuesta'); ?></button>
        </form>
        <?php endif; ?>
        <?php if ($canPublish): ?>
        <form method="post" action="<?php echo $escape($publishUrl); ?>" class="oer-workflow-form oer-drawer-workflow-form">
            <input type="hidden" name="csrf" value="<?php echo $escape($workflowCsrf); ?>">
            <input type="hidden" name="id" value="<?php echo (int) $identity['id']; ?>">
            <button type="submit" class="button"><?php echo $translate('Publicar propuesta'); ?></button>
        </form>
        <?php endif; ?>
        <p class="oer-workflow-error" hidden></p>
    </section>
    <?php endif; ?>

    <?php if ($issueGroups): ?>
    <?php $worst = array_key_first($issueGroups); ?>
    <section class="oer-panel-alert oer-panel-alert-<?php echo $escape($worst); ?>">
        <h4>
            <?php
            $counts = [];
            foreach ($issueGroups as $severity => $issues) {
                $forms = $severityCounts[$severity] ?? null;
                $total = count($issues);
                $counts[] = $forms
                    ? sprintf('%d %s', $total, 1 === $total ? $forms[0] : $forms[1])
                    : sprintf('%d %s', $total, $severity);
            }
            echo $escape(sprintf('%s · %s', $translate(PanelAreas::LABELS['integrity']), implode(', ', $counts)));
            ?>
        </h4>
        <?php foreach ($issueGroups as $severity => $issues): ?>
        <?php // El <h5> no se ve (lo oculta el CSS): es el nombre accesible del glifo. ?>
        <h5><?php echo $escape($severityLabels[$severity] ?? $severity); ?></h5>
        <ul class="oer-integrity-issues oer-integrity-issues-<?php echo $escape($severity); ?>">
            <?php foreach ($issues as $issue): ?>
            <li><?php echo $escape(sprintf(
                '%s: %s',
                $termLabels[$issue['field']] ?? $issue['field'],
                $issue['message']
            )); ?></li>
            <?php endforeach; ?>
        </ul>
        <?php endforeach; ?>
    </section>
    <?php endif; ?>

    <div class="oer-panel-grid">
        <?php $anchor = $area('alignment'); ?>
        <?php
        // El modo lo lleva la sección. Empieza siempre en lectura, también al
        // recargarse tras confirmar: el re-catalogador repuebla el sidebar entero.
        ?>
        <section class="oer-area oer-area-alignment" data-mode="read">
            <h4><?php echo $escape($translate(PanelAreas::LABELS['alignment'])); ?></h4>
            <div class="oer-anchor-read">
                <?php if (PanelAreas::STATE_EMPTY === $anchor['state']): ?>
                <p class="oer-drawer-empty">
                    <?php echo $escape($translate(PanelAreas::ALIGNMENT_EMPTY_TEXT)); ?>
                </p>
                <?php else: ?>
                <?php foreach ($anchor['alignment']['groups'] as $group): ?>
                <div class="oer-align-group">
                    <p class="oer-align-course"><?php echo $escape($group['subjects']
                        ? sprintf('%s · %s', $group['courseTitle'], implode(', ', $group['subjects']))
                        : $group['courseTitle']); ?></p>
                    <?php foreach (['lrmi:teaches' => 'teaches', 'lrmi:assesses' => 'assesses'] as $term => $key): ?>
                    <p class="oer-align-line"><?php echo $escape(sprintf(
                        '%s: %s',
                        $termLabels[$term],
                        $group[$key] ? implode(' · ', $group[$key]) : '—'
                    )); ?></p>
                    <?php endforeach; ?>
                </div>
                <?php endforeach; ?>
                <?php if ($anchor['alignment']['axes']): ?>
                <p class="oer-align-axes"><?php echo $escape(sprintf(
                    '%s: %s',
                    $termLabels['dcterms:relation'],
                    implode(' · ', $anchor['alignment']['axes'])
                )); ?></p>
                <?php endif; ?>
                <?php if ($anchor['alignment']['orphans']): ?>
                <div class="oer-align-orphans">
                    <h5><?php echo $escape($translate('Sin encajar')); ?></h5>
                    <?php foreach ($anchor['alignment']['orphans'] as $orphan): ?>
                    <p class="oer-align-orphan"><?php
                        $label = $termLabels[$orphan['term']] ?? $orphan['term'];
                        $reason = $orphanReasons[$orphan['reason']] ?? null;
                        echo $escape($reason
                            ? sprintf('%s: %s (%s)', $label, $orphan['title'], $reason)
                            : sprintf('%s: %s', $label, $orphan['title']));
                    ?></p>
                    <?php endforeach; ?>
                </div>
                <?php endif; ?>
                <?php endif; ?>
            </div>
            <div class="oer-anchor-slot"></div>
            <div class="oer-anchor-bar"></div>
        </section>

        <div class="oer-panel-side">
            <?php $media = $area('media'); ?>
            <section class="oer-area oer-area-media">
                <h4><?php echo $escape($translate(PanelAreas::LABELS['media'])); ?></h4>
                <?php if (PanelAreas::STATE_EMPTY === $media['state']): ?>
                <?php // Un REA sin ningún medio no es un recurso: aviso, no dato. ?>
                <p class="oer-media-none"><?php echo $escape($translate(PanelAreas::MEDIA_EMPTY_TEXT)); ?></p>
                <?php else: ?>
                <ul class="oer-media-list">
                    <?php foreach ($media['media'] as $one): ?>
                    <li>
                        <?php if (!empty($one['renderedHtml'])): ?>
                        <?php // Renderer nativo de Omeka (MediaRepresentation::render()): HTML de
                        // confianza del propio core, se pinta sin escapar igual que hace
                        // media-render.phtml (`echo $resource->render();`). ?>
                        <div class="oer-media-preview"><?php echo $one['renderedHtml']; ?></div>
                        <?php endif; ?>
                        <div class="oer-media-info">
                            <span class="oer-media-name"><?php echo $escape($one['title']); ?></span>
                            <span class="oer-media-meta"><?php echo $escape(sprintf(
                                '%s · %d KB',
                                $one['type'],
                                (int) round($one['size'] / 1024)
                            )); ?></span>
                            <?php if ($one['url']): ?>
                            <a class="oer-media-open" href="<?php echo $escape($one['url']); ?>"
                               target="_blank" rel="noopener"><?php echo $escape($translate('Abrir')); ?></a>
                            <?php endif; ?>
                        </div>
                    </li>
                    <?php endforeach; ?>
                </ul>
                <?php endif; ?>
            </section>

            <?php $record = $area('record'); ?>
            <section class="oer-area oer-area-record">
                <h4><?php echo $escape($translate(PanelAreas::LABELS['record'])); ?></h4>
                <?php if (PanelAreas::STATE_EMPTY === $record['state']): ?>
                <p class="oer-drawer-empty"><?php echo $escape($translate('Sin ficha descriptiva.')); ?></p>
                <?php else: ?>
                <dl>
                    <?php foreach ($record['record'] as $term => $text): ?>
                    <dt><?php echo $escape($termLabels[$term] ?? $term); ?></dt>
                    <dd><?php echo $escape($text); ?></dd>
                    <?php endforeach; ?>
                </dl>
                <?php endif; ?>
            </section>
        </div>
    </div>

    <?php
    // Licence and authorship (RF-015, TASK-028 slice 3b). Read view since
    // Task 9; `.oer-governance-form` (Task 11) is the edit-mode counterpart of
    // `.oer-anchor-slot`, filled by `asset/js/ui/governance.js` when «Editar»
    // is clicked. `data-mode="read"` follows the same convention as
    // `.oer-area-alignment`, which also toggles read/edit within its own
    // section.
    $govValues = $governance['values'] ?? [];
    $licenceEntries = $govValues[GovernanceFields::LICENCE] ?? [];
    $licenceStatus = $governance['licenceStatus'] ?? LicenceStatus::MISSING;
    $licenceText = $governanceFieldText($licenceEntries);
    $simpleGovernanceTerms = [
        GovernanceFields::CREATOR,
        GovernanceFields::PUBLISHER,
        GovernanceFields::RIGHTS_HOLDER,
        GovernanceFields::SOURCE,
    ];
    // Everything the form needs and the server already computed, for the one
    // client-side read `governance.js` gets (see the file docblock): current
    // values, vocab options, notices, the default rights holder and the CSRF
    // hash this same request already minted. `JSON_HEX_*` keeps it safe to
    // drop straight into a double-quoted HTML attribute (belt-and-braces with
    // $escape(), which already covers the `"` case on its own).
    $governanceData = !empty($governance['canEdit']) ? $escape(json_encode(
        [
            'id' => (int) $identity['id'],
            'values' => $govValues,
            'licenceStatus' => $licenceStatus,
            'options' => $governance['options'] ?? ['licence' => [], 'publisher' => []],
            'notices' => $governance['notices'] ?? [],
            'defaultRightsHolder' => (string) ($governance['defaultRightsHolder'] ?? ''),
            'csrf' => (string) ($governance['csrf'] ?? ''),
        ],
        JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT
    )) : null;
    ?>
    <section
        class="oer-area oer-area-governance"
        data-mode="read"
        data-governance-apply-url="<?php echo $escape($governanceApplyUrl); ?>"
        <?php if (null !== $governanceData): ?>
        data-governance="<?php echo $governanceData; ?>"
        <?php endif; ?>
    >
        <h4><?php echo $escape($translate(PanelAreas::LABELS['governance'])); ?></h4>
        <dl>
            <dt><?php echo $escape($termLabels[GovernanceFields::LICENCE]); ?></dt>
            <dd>
                <?php if ('' === $licenceText): ?>
                <span class="oer-value-missing">
                    <?php echo $escape($translate($governanceMissingText[GovernanceFields::LICENCE])); ?>
                </span>
                <?php else: ?>
                <span class="oer-value"><?php echo $escape($licenceText); ?></span>
                <?php // The one case that earns a mark (ADR-0014): outside the configured vocabulary. ?>
                <?php if (LicenceStatus::OUTSIDE_VOCAB === $licenceStatus): ?>
                <span class="oer-governance-warning">
                    <?php echo $escape($translate('No está en la lista de licencias aprobadas')); // @translate ?>
                </span>
                <?php endif; ?>
                <?php endif; ?>
            </dd>

            <?php foreach ($simpleGovernanceTerms as $term): ?>
            <?php $text = $governanceFieldText($govValues[$term] ?? []); ?>
            <dt><?php echo $escape($termLabels[$term]); ?></dt>
            <dd>
                <?php if ('' === $text): ?>
                <span class="oer-value-missing"><?php echo $escape($translate($governanceMissingText[$term])); ?></span>
                <?php else: ?>
                <span class="oer-value"><?php echo $escape($text); ?></span>
                <?php endif; ?>
            </dd>
            <?php endforeach; ?>
        </dl>

        <?php foreach (($governance['notices'] ?? []) as $notice): ?>
        <p class="oer-governance-notice"><?php echo $escape($translate($notice)); ?></p>
        <?php endforeach; ?>

        <?php // Only hides the button; governanceApplyAction checks the permission again (I2). ?>
        <?php if (!empty($governance['canEdit'])): ?>
        <button
            type="button"
            class="button oer-governance-edit"
            data-item-id="<?php echo (int) $identity['id']; ?>"
        >
            <?php echo $escape($translate('Editar')); // @translate ?>
        </button>
        <?php endif; ?>
        <?php // Filled by governance.js from `data-governance` above; empty in read mode. ?>
        <div class="oer-governance-form"></div>
    </section>

    <?php // Nace plegado y su petición NO se lanza hasta que se despliega (P-6). ?>
    <section class="oer-area oer-area-history">
        <details class="oer-history-box" data-item-id="<?php echo (int) $identity['id']; ?>">
            <summary><?php echo $escape($translate('Historial de curación')); ?></summary>
            <div class="oer-history-body"></div>
        </details>
    </section>

    <?php // La costura que ofrece el core para que otro módulo amplíe el panel. ?>
    <?php $this->trigger('view.details', ['entity' => $panel]); ?>
<?php endif; ?>
</div>
