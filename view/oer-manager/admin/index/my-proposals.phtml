<?php
/**
 * «Mis propuestas» (TASK-067, ADR-0023 §3): the proposer's own REA with their
 * workflow status and the last reason (rejection, discard or unpublication).
 * Proposing again happens on the native item page, which the title links to.
 *
 * TASK-035 §3: «Catalogar» opens the master view's detail panel in a sidebar,
 * with the same `asset/js/main.js` and configuration (`panel-config`), so the
 * proposer re-catalogues their own Borrador or Rechazado REA there. The panel
 * says why when the state does not allow it; no AI, batches or visibility.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\ItemRepresentation[] $items
 * @var int $total
 * @var string $recatalogCsrf
 */

use OERManager\Service\Workflow\WorkflowStatus;

$translate = $this->plugin('translate');
$escape = $this->plugin('escapeHtml');
$this->headLink()->appendStylesheet($this->assetUrl('css/oer-master-view.css', 'OERManager'));
// ADR-0024: the same panel as the master view, so the alignment editor's own look too.
$this->headLink()->appendStylesheet($this->assetUrl('css/oer-alignment-editor.css', 'OERManager'));
$this->headLink()->appendStylesheet($this->assetUrl('css/oer-workflow-badge.css', 'OERManager'));
$this->headScript()->appendFile($this->assetUrl('js/main.js', 'OERManager'), 'module');
$drawerDetailsUrl = $this->url('admin/oer-manager', ['action' => 'drawer-details']);
$this->htmlElement('body')->appendAttribute('class', 'oer-manager my-proposals');
?>
<?php echo $this->pageTitle($translate('Mis propuestas'), 1, $translate('OER Manager')); ?>

<div class="browse-controls">
    <?php echo $this->pagination(); ?>
</div>

<?php if ($items): ?>
<table id="oer-master-view-table" class="tablesaw" data-tablesaw-mode="stack"
<?php echo $this->partial('oer-manager/admin/index/panel-config', [
    'recatalogCsrf' => $recatalogCsrf ?? '',
    'aiEnabled' => false,
]); ?>>
    <thead>
        <tr>
            <th><?php echo $translate('Título'); ?></th>
            <th><?php echo $translate('Estado'); ?></th>
            <th><?php echo $translate('Motivo'); ?></th>
            <th><?php echo $translate('Visibilidad'); ?></th>
            <th><?php echo $translate('Modificado'); ?></th>
            <th><?php echo $translate('Anclaje curricular'); ?></th>
        </tr>
    </thead>
    <tbody>
    <?php foreach ($items as $item): ?>
        <?php
        $statusValue = $item->value(WorkflowStatus::STATUS_TERM);
        $status = null === $statusValue ? null : WorkflowStatus::normalize((string) $statusValue->value());
        // TASK-039: the reason and, if any, its detail.
        $notes = array_map(
            static fn ($value): string => (string) $value->value(),
            $item->value(WorkflowStatus::NOTE_TERM, ['all' => true, 'default' => []])
        );
        $badge = WorkflowStatus::badge($status);
        ?>
        <tr data-resource-id="<?php echo (int) $item->id(); ?>">
            <td><?php echo $item->link($item->displayTitle()); ?></td>
            <td>
                <?php if (null !== $badge): ?>
                    <?php echo $this->partial('oer-manager/common/workflow-badge', ['badge' => $badge]); ?>
                <?php else: ?>
                    <?php echo $escape(null === $status ? $translate('Borrador') : $status); ?>
                <?php endif; ?>
            </td>
            <td><?php echo $escape(implode(' — ', $notes)); ?></td>
            <td><?php echo $escape($item->isPublic() ? $translate('Público') : $translate('Privado')); ?></td>
            <td><?php echo $escape($this->i18n()->dateFormat($item->modified() ?? $item->created())); ?></td>
            <td>
                <a href="#" class="oer-open-drawer sidebar-content"
                   data-item-id="<?php echo (int) $item->id(); ?>"
                   data-sidebar-selector="#oer-detail-sidebar"
                   data-sidebar-content-url="<?php echo $escape($drawerDetailsUrl . '?id=' . (int) $item->id()); ?>"
                   aria-label="<?php echo $escape(sprintf($translate('Catalogar «%s»'), $item->displayTitle())); ?>"><?php echo $escape($translate('Catalogar')); ?></a>
            </td>
        </tr>
    <?php endforeach; ?>
    </tbody>
</table>
<?php else: ?>
<p class="no-resources"><?php echo $translate('No tienes REA propios en tus sitios.'); ?></p>
<?php endif; ?>

<?php // Same sidebar as the master view (ADR-0017 §1): the core fills it. ?>
<div id="oer-detail-sidebar" class="sidebar">
    <?php echo $this->hyperlink('', '#', [
        'class' => 'sidebar-close o-icon-close',
        'title' => $translate('Cerrar el detalle'),
    ]); ?>
    <div class="sidebar-content"></div>
</div>
