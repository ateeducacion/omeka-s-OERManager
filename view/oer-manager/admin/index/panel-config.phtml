<?php
/**
 * Configuration attributes of `#oer-master-view-table`, read once by
 * `asset/js/config.js`. Shared by the master view and «Mis propuestas»
 * (TASK-035 spec §3), so both pages open the same panel with the same URLs.
 * Whether the re-cataloguer is offered is decided per item by the panel
 * (`data-recatalog`, RecatalogRule), not here.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var string $csrfToken visibility CSRF (master view only)
 * @var string $recatalogCsrf
 * @var bool $aiEnabled
 * @var int $totalResults
 * @var bool $canBatchGovernance
 * @var bool $canBatchAi
 */

$escape = $this->plugin('escapeHtml');
$actionUrl = fn (string $action): string => $escape($this->url('admin/oer-manager', ['action' => $action]));
?>
    data-total-results="<?php echo (int) ($totalResults ?? 0); ?>"
    data-can-batch-governance="<?php echo !empty($canBatchGovernance) ? '1' : '0'; ?>"
    data-can-batch-ai="<?php echo !empty($canBatchAi) ? '1' : '0'; ?>"
    data-ai-batch-form-url="<?php echo $escape($this->url('admin/oer-manager-ai-batch', ['action' => 'form'])); ?>"
    data-ai-proposal-discard-url="<?php echo $actionUrl('ai-proposal-discard'); ?>"
    data-set-visibility-url="<?php echo $actionUrl('set-visibility'); ?>"
    data-csrf-token="<?php echo $escape($csrfToken ?? ''); ?>"
    data-search-terms-url="<?php echo $actionUrl('search-terms'); ?>"
    data-curriculum-tree-url="<?php echo $actionUrl('curriculum-tree'); ?>"
    data-recatalog-preview-url="<?php echo $actionUrl('recatalog-preview'); ?>"
    data-recatalog-apply-url="<?php echo $actionUrl('recatalog-apply'); ?>"
    data-recatalog-last-event-url="<?php echo $actionUrl('recatalog-last-event'); ?>"
    data-recatalog-undo-url="<?php echo $actionUrl('recatalog-undo'); ?>"
    data-ai-propose-url="<?php echo $actionUrl('ai-propose'); ?>"
    data-ai-propose-status-url="<?php echo $actionUrl('ai-propose-status'); ?>"
    data-ai-propose-cancel-url="<?php echo $actionUrl('ai-propose-cancel'); ?>"
    data-ai-enabled="<?php echo !empty($aiEnabled) ? '1' : '0'; ?>"
    data-recatalog-csrf="<?php echo $escape($recatalogCsrf ?? ''); ?>"
    data-drawer-history-url="<?php echo $actionUrl('drawer-history'); ?>"
