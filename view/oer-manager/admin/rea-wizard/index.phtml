$msgids = array_merge($msgids, array_values(\OERManager\Controller\Admin\ReaWizardController::MESSAGES));
$strings = [];
foreach ($msgids as $msgid) {
    $strings[$msgid] = $translate($msgid);
}
if (null !== $config) {
    foreach ($config['schema']['data'] as &$field) {
        $field['label'] = $translate((string) $field['label']);
        if ('' !== (string) $field['help']) {
            // An empty msgid would translate to the catalogue's header.
            $strings[(string) $field['help']] = $translate((string) $field['help']);
        }
    }
    unset($field);
}
$json = static fn ($value): string => (string) json_encode(
    $value,
    JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE
);
$resumed = null !== $config && null !== ($config['item'] ?? null);
$pageTitle = $resumed
    ? (string) ($config['item']['values']['dcterms:title'][0] ?? $translate('Tu REA'))
    : $translate('Añadir REA');
$icon = static fn (string $paths): string =>
    '<svg class="oer-wz-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">' . $paths . '</svg>';

$this->htmlElement('body')->appendAttribute('class', 'oer-wizard-page');
$this->headLink()->appendStylesheet($this->assetUrl('css/oer-wizard.css', 'OERManager'));
if (null !== $config) {
    $this->headScript()->appendFile($this->assetUrl('js/wizard.js', 'OERManager'), 'module');
}
?>
<?php echo $this->pageTitle($pageTitle, 1, $translate('Mis propuestas'), $resumed ? $translate('Continuar') : null); ?>

<div class="oer-wizard" id="oer-wizard">
    <div id="page-actions">
        <?php if (null === $config): ?>
        <a class="button" href="<?php echo $escapeAttr($myProposalsUrl); ?>"><?php echo $escape($translate('Volver a Mis propuestas')); ?></a>
        <?php else: ?>
        <span data-wz-actions></span>
        <?php endif; ?>
    </div>

    <?php if (null !== $config): ?>
    <p class="oer-wz-autosave">
        <?php echo $icon('<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>'); ?>
        <?php echo $escape($translate('Lo que escribes se guarda en este equipo')); ?>
    </p>
    <nav aria-label="<?php echo $escapeAttr($translate('Pasos para añadir el REA')); ?>">
        <ol class="oer-wz-steps" data-wz-steps></ol>
    </nav>
    <?php endif; ?>

    <div class="oer-wz-main" data-wz-main>
        <?php if (null === $config): ?>
        <div class="oer-wz-notice is-important" role="alert">
            <?php echo $icon('<circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/>'); ?>
            <div class="oer-wz-notice-body">
                <p class="oer-wz-notice-title"><?php echo $escape($notice ?? ''); ?></p>
                <?php if (!empty($configUrl) && $this->userIsAllowed(\OERManager\Controller\Admin\IndexController::class, 'config')): ?>
                <p><a href="<?php echo $escapeAttr($configUrl); ?>"><?php echo $escape($translate('Ir a la configuración del módulo')); ?></a></p>
                <?php endif; ?>
            </div>
        </div>
        <?php else: ?>
        <noscript><p><?php echo $escape($translate('El asistente necesita JavaScript.')); ?></p></noscript>
        <?php endif; ?>
    </div>
</div>
<?php if (null !== $config): ?>
<script type="application/json" id="oer-wizard-config"><?php echo $json($config + ['strings' => $strings]); ?></script>
<?php endif; ?>
