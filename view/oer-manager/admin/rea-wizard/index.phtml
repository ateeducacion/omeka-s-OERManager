        </div>
    </header>

    <section class="oer-wz-hero oer-wz-dark">
        <div class="oer-wz-wrap">
            <div class="oer-wz-hero-head">
                <div>
                    <p class="oer-wz-cap"><?php echo $escape($heroCap); ?></p>
                    <h1><?php echo $escape($heroTitle); ?></h1>
                </div>
                <?php if (null !== $config): ?>
                <p class="oer-wz-autosave">
                    <?php echo $icon('<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/>'); ?>
                    <?php echo $escape($translate('Lo que escribes se guarda en este equipo')); ?>
                </p>
                <?php endif; ?>
            </div>
            <nav aria-label="<?php echo $escapeAttr($translate('Pasos para añadir el REA')); ?>">
                <ol class="oer-wz-steps" data-wz-steps></ol>
            </nav>
        </div>
    </section>

    <main class="oer-wz-main" data-wz-main>
        <?php if (null === $config): ?>
        <div class="oer-wz-notice is-important" role="alert">
            <?php echo $icon('<circle cx="12" cy="12" r="9"/><path d="M12 8v5M12 16h.01"/>'); ?>
            <div class="oer-wz-notice-body">
                <p class="oer-wz-notice-title"><?php echo $escape($notice ?? ''); ?></p>
                <?php if (!empty($configUrl) && $this->userIsAllowed(\OERManager\Controller\Admin\IndexController::class, 'config')): ?>
                <p><a href="<?php echo $escapeAttr($configUrl); ?>"><?php echo $escape($translate('Ir a la configuración del módulo')); ?></a></p>
                <?php endif; ?>
                <p><a href="<?php echo $escapeAttr($myProposalsUrl); ?>"><?php echo $escape($translate('Volver a Mis propuestas')); ?></a></p>
            </div>
        </div>
        <?php else: ?>
        <noscript><p><?php echo $escape($translate('El asistente necesita JavaScript.')); ?></p></noscript>
        <?php endif; ?>
    </main>

    <footer class="oer-wz-foot oer-wz-dark">
        <div class="oer-wz-wrap">
            <?php echo $escape($translate('Área de Tecnología Educativa · Consejería de Educación del Gobierno de Canarias')); ?>
        </div>
    </footer>
</div>
<?php if (null !== $config): ?>
<script type="application/json" id="oer-wizard-config"><?php echo $json($config + ['strings' => $strings]); ?></script>
<script type="module" src="<?php echo $escapeAttr($this->assetUrl('js/wizard.js', 'OERManager')); ?>"></script>
