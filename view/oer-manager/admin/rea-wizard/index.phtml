$msgids = array_merge($msgids, array_values(\OERManager\Controller\Admin\ReaWizardController::MESSAGES));
$strings = [];
foreach ($msgids as $msgid) {
    $strings[$msgid] = $translate($msgid);
}
if (null !== $config) {
    foreach ($config['schema']['data'] as &$field) {
        $field['label'] = $translate((string) $field['label']);
        if ('' !== (string) $field['help']) {
            // An empty msgid would translate to the catalogue's header.
            $strings[(string) $field['help']] = $translate((string) $field['help']);
        }
    }
    unset($field);
}
$json = static fn ($value): string => (string) json_encode(
    $value,
    JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_UNICODE
);
$resumed = null !== $config && null !== ($config['item'] ?? null);
$heroCap = $resumed ? $translate('Continuar una propuesta') : $translate('Añadir un REA');
$heroTitle = $resumed
    ? (string) ($config['item']['values']['dcterms:title'][0] ?? $translate('Tu REA'))
    : $translate('Comparte un recurso educativo');
$icon = static fn (string $paths): string =>
    '<svg class="oer-wz-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">' . $paths . '</svg>';
